  *
  * SECURITY: Most commands require a private window
  */
+// claude-zen-sandbox: tell the window what Claude is doing. windows.update({titlePreface})
+// puts "Claude is working · " in front of the window title and in the window's
+// titlepreface attribute, which userChrome.css reads to pick the pixel Claude's animation.
+const MOOD_ACT = new Set(['navigate', 'createWindow', 'click', 'type', 'pressKey', 'scroll', 'closeTab',
+  'attachTab', 'handleConsent', 'setViewport', 'resizeWindow', 'evaluate']);
+const MOOD_READ = new Set(['getContent', 'getAccessibilitySnapshot', 'getPageState', 'find', 'getElementInfo',
+  'screenshot', 'waitFor', 'getConsoleLogs', 'getNetworkRequests', 'getTabs', 'listAllTabs']);
+let moodTimer = null;
+let moodNow = '';
+function setMood(mood, retry = true) {
+  if (!claudezillaWindow) { if (retry) setTimeout(() => setMood(mood, false), 1500); return; }   // createWindow: not open yet
+  if (mood === moodNow) return;
+  moodNow = mood;
+  const titlePreface = { acting: 'Claude is working · ', reading: 'Claude is reading · ', idle: '' }[mood];
+  browser.windows.update(claudezillaWindow.windowId, { titlePreface }).catch(() => { moodNow = ''; });
+}
+function claudeMood(command) {
+  const mood = MOOD_ACT.has(command) ? 'acting' : MOOD_READ.has(command) ? 'reading' : null;
+  if (!mood) return;
+  setMood(mood);
+  clearTimeout(moodTimer);
+  moodTimer = setTimeout(() => setMood('idle'), mood === 'acting' ? 6000 : 4000);
+}
+
 async function handleCliCommand(message) {
   const { id, command, params = {} } = message;
+  claudeMood(command);   // claude-zen-sandbox: the pixel Claude's mood
+  // ...and bring the tab it acts on to the front, so you see what it does
+  if (MOOD_ACT.has(command) && Number.isInteger(params.tabId)) browser.tabs.update(params.tabId, { active: true }).catch(() => {});
 
   console.log('[claudezilla] CLI command:', command);
 
